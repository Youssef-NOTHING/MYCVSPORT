{
  "name": "youssef-sports-portfolio",
  "version": "1.0.0",
  "description": "Professional basketball portfolio website for Youssef Boukhmiss",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently \"node backend/server.js\" \"npm run serve-frontend\"",
    "serve-frontend": "http-server frontend -p 3001 -c-1 --proxy http://localhost:3000",
    "build": "echo 'Build completed - static files ready'",
    "test": "echo 'No tests specified'",
    "backend": "cd backend && node server.js",
    "frontend": "http-server frontend -p 3001 -o",
    "install-deps": "npm install && cd backend && npm install"
  },
  "keywords": [
    "basketball",
    "sports",
    "portfolio",
    "athlete",
    "morocco",
    "europe",
    "showcase"
  ],
  "author": "Youssef Boukhmiss <youssefboukhmiss44@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "http-server": "^14.1.1",
    "nodemon": "^3.0.1"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "path": "^0.12.7",
    "fs": "^0.0.1-security"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Youssef-NOTHING/SPORT.git"
  },
  "homepage": "https://youssef-basketball-portfolio.netlify.app"
}